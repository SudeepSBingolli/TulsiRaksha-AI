# Voice Assistant Configuration
# Copy this to .env.local and fill in your API keys

# ============================================
# ElevenLabs Text-to-Speech API
# ============================================
# Sign up: https://elevenlabs.io/
# Get API key from: https://elevenlabs.io/app/home (Settings → API Keys)
ELEVENLABS_API_KEY=sk_22c325011746904471634d3730228fe778160d394a7ba968
NEXT_PUBLIC_ELEVENLABS_ENABLED=true

# Default voice ID (ElevenLabs)
# You can find other voices at https://elevenlabs.io/docs/api-reference/get-voices
NEXT_PUBLIC_DEFAULT_VOICE_ID=EXAVITQu4vLvkujnVJL5

# ============================================
# Voice Personalization Settings
# ============================================
# Enable user voice customization (requires consent)
NEXT_PUBLIC_VOICE_PERSONALIZATION_ENABLED=true

# Maximum audio duration in seconds (for cost control)
MAX_TTS_DURATION=60

# Cache generated audio (improves performance)
NEXT_PUBLIC_CACHE_AUDIO=true

# ============================================
# Health Data Integration
# ============================================
# Enable automatic voice alerts for health events
NEXT_PUBLIC_VOICE_HEALTH_ALERTS=true

# Minimum interval between voice alerts (in minutes)
MIN_VOICE_ALERT_INTERVAL=10

# Risk levels that trigger voice alerts
# Options: HIGH, CRITICAL
VOICE_ALERT_RISK_LEVELS=HIGH,CRITICAL
